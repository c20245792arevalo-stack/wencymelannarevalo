  <section id="contact" class="card-section">
            <h2 class="text-xs uppercase tracking-widest font-semibold text-yellow-300 mb-6">Contact</h2>

            <form action="#" class="flex flex-col gap-5 w-full max-w-md">
                <div class="flex flex-col gap-1">
                    <label for="name" class="text-xs text-blue-200 uppercase tracking-wider">Name</label>
                    <input type="text" id="name" name="name" required class="minimal-input">
                </div>

                <div class="flex flex-col gap-1">
                    <label for="email" class="text-xs text-blue-200 uppercase tracking-wider">Email</label>
                    <input type="email" name="email" id="email" required class="minimal-input">
                </div>

                <div class="flex flex-col gap-1">
                    <label for="message" class="text-xs text-blue-200 uppercase tracking-wider">Message</label>
                    <textarea name="message" id="message" rows="4" required class="minimal-input"></textarea>
                </div>

                <button type="submit" class="btn-primary mt-2 w-full">
                    Send Message
                </button>
            </form>
        </section>