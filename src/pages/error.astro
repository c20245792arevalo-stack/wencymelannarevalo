---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Message Not Sent">
  <main class="min-h-[70vh] flex items-center justify-center px-6">
    <section class="text-center max-w-lg">
      <h1 class="text-3xl font-semibold text-yellow-300 mb-4">Message not sent</h1>
      <p class="text-blue-100 mb-8">Please check your details and try again.</p>
      <a href="/#contact" class="btn-primary inline-block">Try again</a>
    </section>
  </main>
</BaseLayout>
